<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Aviso global de "sin conexión" (ui/Connectivity.android.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permisos para impresoras térmicas Bluetooth. -->
    <!-- Legacy (Android 11 y menores): permiso normal, no requiere runtime request. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12+ (API 31): permiso runtime para conectar a paired devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Push de pedidos. Android 13+ (API 33) lo pide en runtime; en versiones
         anteriores se concede al instalar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ubicación de la sucursal, capturada una sola vez al crear su primer
         pedido (ver ProductionOrderFormScreen / LocationRequester). Permiso
         runtime "mientras se usa la app" en todas las versiones soportadas
         (minSdk 24); si se niega, la encargada vuelve a Inicio y no puede
         crear el pedido para esa sucursal. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Selfie al marcar asistencia en el kiosko (SelfieCamera.android.kt). Se pide en
         runtime al abrir la cámara. OJO: con CAMERA declarado, ACTION_IMAGE_CAPTURE lanza
         SecurityException si el permiso no está concedido; por eso ImagePickerButton lo
         pide antes de abrir la app de cámara. No es "required": hay tablets sin cámara
         y la app no debe desaparecer de Play Store para ellas. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".BakeryApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BakeOS.Splash">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Canal por defecto de FCM. Sin esto, un push que llegue con la app
             cerrada cae en un canal "Miscellaneous" silencioso. El id debe
             coincidir con ORDERS_NOTIFICATION_CHANNEL_ID y con functions/index.js. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bakeos_pedidos" />
        <!-- Entrega a la app de camara la Uri del archivo destino. Desde Android 7 pasar
             una Uri "file://" a otra app lanza FileUriExposedException. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Baja el modelo de caras de ML Kit al instalar, no la primera vez que alguien
             marca (si no, esa primera selfie sale sin verificar). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    </application>

</manifest>