rules_version = '2';

// Reglas de Firestore de BakeOS. Se publican desde aquí con
//   firebase deploy --only firestore:rules
// (antes vivían solo en la consola y este archivo estaba desactualizado).
// Pruebas: rules-tests/ (npm test, levanta el emulador).
//
// Idea general:
//   - El perfil users/{uid} es la llave de todo: orgId, role, isApproved, isActive.
//     Por eso NADIE puede tocar esos campos de su propio perfil después de crearlo
//     (antes cualquiera podía ponerse OWNER o cambiarse de empresa).
//   - Los datos de la empresa (companies/{id}/**) solo los ve quien pertenece a esa
//     empresa Y está aprobado y activo. Los permisos finos (cobrar, editar recetas...)
//     siguen viviendo en la app; aquí se cierra la puerta a extraños y a pendientes.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath(id) {
      return /databases/$(database)/documents/users/$(id);
    }

    function orgPath(id) {
      return /databases/$(database)/documents/organizations/$(id);
    }

    function hasProfile() {
      return isAuth() && exists(userPath(uid()));
    }

    // Perfil de quien hace la petición. Solo llamar después de hasProfile().
    function me() {
      return get(userPath(uid())).data;
    }

    // Documentos viejos no traen isApproved (el OWNER original): ausente = aprobado.
    function isEnabled(u) {
      return u.get('isApproved', true) == true && u.get('isActive', true) == true;
    }

    // Personal de la empresa aprobado y activo.
    function isStaffOf(orgId) {
      return hasProfile()
        && me().orgId == orgId
        && me().role in ['OWNER', 'ADMIN', 'MANAGER', 'EMPLOYEE']
        && isEnabled(me());
    }

    // Personal o revendedor aprobado. El revendedor conserva por ahora el mismo
    // acceso que tenía (pendiente: limitarlo a sus pedidos y precios).
    function isApprovedMemberOf(orgId) {
      return hasProfile()
        && me().orgId == orgId
        && me().role in ['OWNER', 'ADMIN', 'MANAGER', 'EMPLOYEE', 'RESELLER']
        && isEnabled(me());
    }

    function isAdminOf(orgId) {
      return isStaffOf(orgId) && me().role in ['OWNER', 'ADMIN'];
    }

    function isOwnerOf(orgId) {
      return isStaffOf(orgId) && me().role == 'OWNER';
    }

    function hasPermission(p) {
      return me().role == 'OWNER' || p in me().get('permissions', []);
    }

    // Revendedor recién registrado (aún sin aprobar) de esa empresa.
    function isResellerOf(orgId) {
      return hasProfile() && me().orgId == orgId && me().role == 'RESELLER';
    }

    // ── Forma de un perfil nuevo ────────────────────────────────────────────
    // Solo hay cuatro formas legítimas de nacer (ver FirebaseAuthRepository):
    //   1. Google por primera vez: sin empresa todavía (orgId vacío).
    //   2. Dueño de una empresa NUEVA: role OWNER con un orgId que aún no existe.
    //   3. Empleado que se une con código: EMPLOYEE, pendiente de aprobación.
    //   4. Revendedor que se registra con código: RESELLER, pendiente.
    // En ninguna trae permisos ni sucursales: eso lo asigna un OWNER/ADMIN.

    function profileKeysOk(d) {
      return d.keys().hasOnly(['orgId', 'email', 'displayName', 'role', 'branchIds',
                               'permissions', 'isActive', 'isApproved', 'photoUrl',
                               'isDeviceAccount'])
        && d.orgId is string
        && d.get('permissions', []).size() == 0
        && d.get('branchIds', []).size() == 0
        && d.get('isDeviceAccount', false) == false;
    }

    function isNewProfileOk(d) {
      return profileKeysOk(d) && (
        d.orgId == ''
        || (d.role == 'OWNER' && !exists(orgPath(d.orgId)))
        || (d.role in ['EMPLOYEE', 'RESELLER']
            && d.isApproved == false
            && exists(orgPath(d.orgId)))
      );
    }

    // ── Usuarios ────────────────────────────────────────────────────────────

    match /users/{userId} {
      // El propio perfil, aunque esté pendiente.
      allow get: if isAuth() && uid() == userId;

      // Compañeros de la misma empresa (selectores de cajero, piloto, etc.).
      // Solo para quien ya está aprobado: un pendiente no ve la lista del personal.
      allow get, list: if isApprovedMemberOf(resource.data.orgId);

      allow create: if isAuth() && uid() == userId
                    && isNewProfileOk(request.resource.data);

      // Uno mismo: solo nombre y foto. Rol, empresa, permisos, sucursales y
      // aprobación los cambia un OWNER/ADMIN, nunca el interesado.
      allow update: if isAuth() && uid() == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'photoUrl']);

      // Onboarding después de Google: quien todavía no tiene empresa elige
      // crear una (OWNER) o unirse a una (pendiente).
      allow update: if isAuth() && uid() == userId
                    && resource.data.orgId == ''
                    && isNewProfileOk(request.resource.data);

      // OWNER/ADMIN administran a la gente de su empresa: aprobar, permisos,
      // sucursales, rol. Un ADMIN no puede crear OWNERs ni tocar a un OWNER.
      allow update: if isAdminOf(resource.data.orgId)
                    && request.resource.data.orgId == resource.data.orgId
                    && (
                      me().role == 'OWNER'
                      || (resource.data.role != 'OWNER' && request.resource.data.role != 'OWNER')
                    );

      // Quien gestiona clientes externos aprueba al revendedor (solo isApproved).
      allow update: if resource.data.role == 'RESELLER'
                    && isStaffOf(resource.data.orgId)
                    && hasPermission('MANAGE_EXTERNAL_CUSTOMERS')
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isApproved']);

      allow delete: if false;
    }

    // ── Organizaciones ──────────────────────────────────────────────────────

    match /organizations/{orgId} {
      // Su propia empresa (aunque esté pendiente: la pantalla de espera muestra
      // el nombre). Nadie puede listar todas las empresas.
      allow get: if hasProfile() && me().orgId == orgId;
      allow list: if false;

      // Se crea justo después del perfil OWNER que la reclama.
      allow create: if hasProfile()
                    && me().orgId == orgId
                    && me().role == 'OWNER'
                    && request.resource.data.ownerEmail.lower() == request.auth.token.email.lower();

      allow update: if isAdminOf(orgId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerEmail'])
                        || isOwnerOf(orgId));

      allow delete: if false;
    }

    // ── Códigos de invitación ───────────────────────────────────────────────

    match /inviteCodes/{code} {
      // Hay que conocer el código para leerlo; no se pueden enumerar.
      allow get: if isAuth();
      allow list: if false;
      allow create: if isAdminOf(request.resource.data.orgId);
      allow delete: if isAdminOf(resource.data.orgId);
      allow update: if false;
    }

    // ── Datos de la empresa ─────────────────────────────────────────────────

    match /companies/{companyId} {
      allow read, write: if isApprovedMemberOf(companyId);
    }

    // ── Fase 4: qué se puede tocar dentro de la empresa ─────────────────────
    // Las reglas ven los permisos de la CUENTA. En un equipo de sucursal eso es el techo:
    // la app ya recorta a lo que puede la persona (cuenta ∩ colaborador), así que estas
    // reglas nunca son más estrictas que la app y no la pueden trabar.

    // Configuración que solo se edita desde su pantalla de administración, y con permiso.
    // `employees` tiene sus reglas propias (abajo); `felProfiles` lo escribe solo la
    // Cloud Function de facturación.
    function canWriteCollection(companyId, collection) {
      return isApprovedMemberOf(companyId)
        && !(collection in ['employees', 'felProfiles'])
        // packagingItems: el precio de la bolsa lo cobran todas las cajas. paymentRules: el
        // mínimo y el recargo de tarjeta, igual.
        && (!(collection in ['cashRegisters', 'saleQuickGroups', 'packagingItems', 'paymentRules']) || hasPermission('MANAGE_POS_CONFIG'))
        && (collection != 'priceLists' || hasPermission('MANAGE_PRICE_LISTS'))
        // Congelar el costo estándar cambia el valor de todos los despachos del mes.
        && (!(collection in ['standardCosts', 'standardCostPeriods']) || hasPermission('MANAGE_PRICE_LISTS'))
        && (collection != 'fixedBudget' || hasPermission('MANAGE_FIXED_BUDGET'))
        && (collection != 'externalCustomers' || externalCustomerWriteOk())
        && (collection != 'jobPositions' || hasPermission('MANAGE_EMPLOYEES'));
    }

    // Clientes externos. La lista de precios de un revendedor ES el precio al que se le vende:
    // darlo de alta, aprobarlo, cambiarle la lista, activarlo o borrarlo es de quien maneja
    // precios. Con MANAGE_EXTERNAL_CUSTOMERS se manejan los clientes recurrentes y se corrigen
    // los datos de contacto de un revendedor sin tocar nada de eso.
    function externalCustomerWriteOk() {
      return hasPermission('MANAGE_PRICE_LISTS')
        || (hasPermission('MANAGE_EXTERNAL_CUSTOMERS') && (
             (request.method == 'delete' && resource.data.get('type', 'RESELLER') != 'RESELLER')
             || (request.method != 'delete'
                 && request.resource.data.get('type', 'RESELLER') != 'RESELLER'
                 && (resource == null || resource.data.get('type', 'RESELLER') != 'RESELLER'))
             || (request.method == 'update'
                 && resource.data.get('type', 'RESELLER') == 'RESELLER'
                 && request.resource.data.get('type', 'RESELLER') == 'RESELLER'
                 && request.resource.data.get('priceListId', '') == resource.data.get('priceListId', '')
                 && request.resource.data.get('registrationStatus', 'ACTIVE') == resource.data.get('registrationStatus', 'ACTIVE')
                 && request.resource.data.get('active', true) == resource.data.get('active', true))));
    }

    // Historial: se corrige escribiendo la diferencia, nunca borrando (CLAUDE.md). La app
    // no borra estos documentos en ningún lado; ahora tampoco se puede saltándose la app.
    function isHistory(collection) {
      return collection in ['sales', 'salesDaily', 'cashSessions', 'cashTransfers',
                            'cashAuditEvents', 'dailyCashCloses', 'spotCashChecks',
                            'customerDeposits', 'dtes', 'finishedMovements',
                            'creditAccounts', 'counters', 'bankDeposits', 'counterRemovals',
                            'stockTransfers'];
    }

    // Subcolecciones que también son historial (el resto, p. ej. los billetes contados de
    // una caja, la app sí los reemplaza).
    function isHistorySub(collection, sub) {
      return (collection == 'sales' && sub == 'lines')
        || (collection == 'cashSessions' && sub == 'movements')
        || (collection == 'ingredients' && sub == 'movements');
    }

    function canAccessBranch(branchId) {
      return me().role == 'OWNER'
        || me().get('branchIds', []).size() == 0
        || branchId in me().get('branchIds', []);
    }

    // Una venta o una caja nueva nace en una sucursal de la cuenta.
    function branchOkOnCreate(collection) {
      return !(collection in ['sales', 'cashSessions'])
        || canAccessBranch(request.resource.data.get('branchId', ''));
    }

    match /companies/{companyId}/{collection}/{docId} {
      allow read: if isApprovedMemberOf(companyId);
      allow create: if canWriteCollection(companyId, collection) && branchOkOnCreate(collection);
      allow update: if canWriteCollection(companyId, collection);
      allow delete: if canWriteCollection(companyId, collection) && !isHistory(collection);
    }

    match /companies/{companyId}/{collection}/{docId}/{sub}/{rest=**} {
      allow read: if isApprovedMemberOf(companyId);
      allow create, update: if canWriteCollection(companyId, collection);
      allow delete: if canWriteCollection(companyId, collection) && !isHistorySub(collection, sub);
    }

    // Ficha del colaborador: el formulario la edita cualquiera del personal que la app
    // deje entrar, pero sus permisos (lo que puede hacer con su PIN) solo OWNER/ADMIN, y
    // el estado del PIN solo la Cloud Function (functions/access/employeeAccess.js).
    match /companies/{companyId}/employees/{employeeId} {
      allow create: if isApprovedMemberOf(companyId)
                    && !request.resource.data.keys().hasAny(['pinStatus', 'pinUpdatedAt'])
                    && (request.resource.data.get('permissions', []).size() == 0 || isAdminOf(companyId));
      allow update: if isApprovedMemberOf(companyId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinStatus', 'pinUpdatedAt'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions'])
                        || isAdminOf(companyId));
      allow delete: if isApprovedMemberOf(companyId);
    }

    // Subcolecciones (documentos, historial...). `{sub}/{rest=**}` y no `{sub=**}`: este
    // último también calza con CERO segmentos, o sea con la ficha misma, y la dejaba abierta.
    match /companies/{companyId}/employees/{employeeId}/{sub}/{rest=**} {
      allow write: if isApprovedMemberOf(companyId);
    }

    // Hash del PIN: solo el Admin SDK. Ni el dueño lo lee desde la app.
    match /employeePins/{id} {
      allow read, write: if false;
    }

    // Revendedor recién registrado: completa su ficha y escoge sucursal antes
    // de que lo aprueben (ResellerSetupScreen). Nada más.
    match /companies/{companyId}/branches/{branchId} {
      allow read: if isResellerOf(companyId);
    }

    match /companies/{companyId}/externalCustomers/{customerId} {
      allow create: if isResellerOf(companyId)
                    && request.resource.data.linkedUserId == uid()
                    && request.resource.data.active == false;
    }
  }
}
